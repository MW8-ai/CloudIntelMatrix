{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MW8-ai/CloudIntelMatrix/blob/main/data/schema.json",
  "title": "Cloud Intelligence Matrix capability-v1",
  "description": "Schema contract for data/matrix.json, including capability rows, architecture-pattern overlays, and a control-family planning lens. Unknown public-source facts must be explicit and explained with sourceNotes.",
  "type": "object",
  "required": ["_meta", "tags", "categories", "frameworks", "controlLens", "complianceFrameworks", "patterns", "capabilities"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["version", "schema", "last_verified", "providers", "tiers", "license", "repo"],
      "properties": {
        "version": { "type": "string" },
        "schema": { "const": "capability-v1" },
        "last_verified": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "providers": {
          "type": "array",
          "items": { "enum": ["aws", "azure", "gcp", "oci"] },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "tiers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "license": { "type": "string" },
        "repo": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "color", "description"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "frameworks": {
      "type": "object",
      "required": ["aws", "azure", "gcp", "oci"],
      "properties": {
        "aws": { "$ref": "#/$defs/framework" },
        "azure": { "$ref": "#/$defs/framework" },
        "gcp": { "$ref": "#/$defs/framework" },
        "oci": { "$ref": "#/$defs/framework" }
      },
      "additionalProperties": false
    },
    "controlLens": { "$ref": "#/$defs/controlLens" },
    "complianceFrameworks": {
      "type": "array",
      "items": { "$ref": "#/$defs/complianceFramework" },
      "minItems": 1
    },
    "patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/pattern" },
      "minItems": 1
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" },
      "minItems": 1
    }
  },
  "$defs": {
    "framework": {
      "type": "object",
      "required": ["framework", "frameworkUrl", "foundation", "foundationUrl", "lastVerified"],
      "properties": {
        "framework": { "type": "string", "minLength": 1 },
        "frameworkUrl": { "type": "string", "format": "uri" },
        "foundation": { "type": "string", "minLength": 1 },
        "foundationUrl": { "type": "string", "format": "uri" },
        "lastVerified": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "pattern": {
      "type": "object",
      "required": [
        "id",
        "name",
        "summary",
        "whenToUse",
        "capabilities",
        "reviewPrompts",
        "verificationNote",
        "lastVerified"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "whenToUse": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "reviewPrompts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "verificationNote": { "type": "string", "minLength": 1 },
        "lastVerified": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "controlLens": {
      "type": "object",
      "required": ["id", "name", "release", "catalogUrl", "baselineUrl", "oscalUrl", "scopeNote", "lastVerified", "families"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "catalogUrl": { "type": "string", "format": "uri" },
        "baselineUrl": { "type": "string", "format": "uri" },
        "oscalUrl": { "type": "string", "format": "uri" },
        "scopeNote": { "type": "string", "minLength": 1 },
        "lastVerified": { "type": "string", "format": "date" },
        "families": {
          "type": "array",
          "items": { "$ref": "#/$defs/controlFamily" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "controlFamily": {
      "type": "object",
      "required": ["id", "name", "applicability", "capabilities", "reviewPrompts"],
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 2 },
        "name": { "type": "string", "minLength": 1 },
        "applicability": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "reviewPrompts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "complianceFramework": {
      "type": "object",
      "required": ["id", "name", "issuer", "kind", "scope", "status", "url", "nistAlignment", "lastVerified"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["authorization-program", "regulation", "validation-standard", "voluntary-framework"]
        },
        "scope": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["Active", "Draft", "In development", "Superseded"]
        },
        "url": { "type": "string", "format": "uri" },
        "nistAlignment": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          ]
        },
        "historicalNote": { "type": "string", "minLength": 1 },
        "lastVerified": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": [
        "capability",
        "category",
        "tags",
        "aiClassification",
        "architectureNotes",
        "operationalConsiderations",
        "lastVerified",
        "providers"
      ],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "aiClassification": {
          "enum": ["STANDARD", "AI_CAPABLE", "AI_NATIVE"]
        },
        "architectureNotes": { "type": "string", "minLength": 1 },
        "operationalConsiderations": { "type": "string", "minLength": 1 },
        "lastVerified": { "type": "string", "format": "date" },
        "sourceNotes": { "type": "string", "minLength": 1 },
        "providers": {
          "type": "object",
          "required": ["aws", "azure", "gcp", "oci"],
          "properties": {
            "aws": { "$ref": "#/$defs/provider" },
            "azure": { "$ref": "#/$defs/provider" },
            "gcp": { "$ref": "#/$defs/provider" },
            "oci": { "$ref": "#/$defs/provider" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": [
        "service",
        "status",
        "govAvailability",
        "parityLag",
        "docsUrl",
        "pricingUrl",
        "complianceUrl",
        "tierNotes"
      ],
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "formerNames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "status": {
          "enum": ["GA", "Preview", "Deprecated", "Retiring", "Unknown"]
        },
        "govAvailability": {
          "enum": ["Full", "Partial", "Limited", "None", "Unknown"]
        },
        "govVariant": { "type": "string" },
        "region": { "type": "string", "minLength": 1 },
        "realmClass": {
          "enum": ["commercial", "us-gov", "eu-sovereign", "other-sovereign"]
        },
        "lastVerified": { "type": "string", "format": "date" },
        "parityLag": {
          "enum": ["None", "Minor", "Moderate", "Significant", "Unknown"]
        },
        "docsUrl": { "type": ["string", "null"], "format": "uri" },
        "pricingUrl": { "type": ["string", "null"], "format": "uri" },
        "complianceUrl": { "type": ["string", "null"], "format": "uri" },
        "govDocsUrl": { "type": ["string", "null"], "format": "uri" },
        "sourceNotes": { "type": "string", "minLength": 1 },
        "parityDetail": { "type": "string", "minLength": 1 },
        "constraints": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": true
            }
          ]
        },
        "costModel": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "shape": { "enum": ["consumption", "provisioned", "hybrid", "Unknown"] },
            "egressSensitive": { "type": "boolean" },
            "commitmentDiscountAvailable": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "pqcReadiness": {
          "type": "object",
          "minProperties": 1,
          "required": ["status", "fipsEndpointParity", "confidence"],
          "properties": {
            "kem": { "type": "string", "minLength": 1 },
            "signature": { "type": "string", "minLength": 1 },
            "tls": { "type": "string", "minLength": 1 },
            "vpn": { "type": "string", "minLength": 1 },
            "status": { "enum": ["GA", "Hybrid-Preview", "Roadmap", "Unknown", "None"] },
            "milestoneDate": { "type": ["string", "null"], "minLength": 1 },
            "fipsEndpointParity": { "enum": ["AtParity", "Lagging", "Unknown"] },
            "govPqc": { "type": "string", "minLength": 1 },
            "source": { "type": ["string", "null"], "format": "uri" },
            "sourceDate": { "type": "string", "minLength": 1 },
            "firstParty": { "type": "boolean" },
            "confidence": { "enum": ["High", "Medium", "Low"] },
            "note": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "fedramp": {
          "type": "object",
          "required": ["commercial", "government"],
          "properties": {
            "commercial": { "$ref": "#/$defs/fedrampEnvironment" },
            "government": { "$ref": "#/$defs/fedrampGovernmentEnvironment" }
          },
          "additionalProperties": false
        },
        "fedrampLevel": { "enum": ["High", "Moderate", "Low", "Unknown"] },
        "dodImpactLevel": { "type": "string", "minLength": 1 },
        "tierNotes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "fedrampEnvironment": {
      "type": "object",
      "required": ["status", "confidence"],
      "properties": {
        "status": { "enum": ["High", "Moderate", "Low", "None", "Unknown"] },
        "url": { "type": "string" },
        "date": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["High", "Medium", "Low"] },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "fedrampGovernmentEnvironment": {
      "type": "object",
      "required": ["status", "dodIL", "confidence"],
      "properties": {
        "status": { "enum": ["High", "Moderate", "Low", "None", "Unknown"] },
        "dodIL": { "enum": ["IL2", "IL4", "IL5", "IL6", "None", "Unknown"] },
        "boundary": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "date": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["High", "Medium", "Low"] },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
