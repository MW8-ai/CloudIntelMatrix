    {
      "capability": "ML Platform & Model Training",
      "provider": "aws",
      "field": "parityLag",
      "currentValue": "Unknown",
      "proposedValue": "Significant",
      "sourceUrl": "https://docs.aws.amazon.com/govcloud-us/latest/UserGuide/govcloud-sagemaker.html",
      "sourceQuote": "Only the following features are available.",
      "rationale": "AWS documents SageMaker AI in AWS GovCloud as a limited feature subset where API calls to unavailable features fail. Because the mapped capability is the ML platform and model-training surface, this is proposed as a Significant parity lag.",
      "proposedOn": "2026-06-16"
    },
    {
      "capability": "Data Warehouse / Analytics Platform",
      "provider": "aws",
      "field": "parityLag",
      "currentValue": "Unknown",
      "proposedValue": "Minor",
      "sourceUrl": "https://docs.aws.amazon.com/govcloud-us/latest/UserGuide/govcloud-redshift.html",
      "sourceQuote": "The COPY EXPLICIT_IDS parameter is not available.",
      "rationale": "AWS documents a narrow Redshift feature difference in AWS GovCloud along with SSL certificate-bundle handling. Core Redshift remains available and the documented feature gap is narrow, so the proposed lag is Minor.",
      "proposedOn": "2026-06-16"
    },
    {
      "capability": "Managed File Transfer",
      "provider": "aws",
      "field": "parityLag",
      "currentValue": "Unknown",
      "proposedValue": "Moderate",
      "sourceUrl": "https://docs.aws.amazon.com/govcloud-us/latest/UserGuide/govcloud-tf.html",
      "sourceQuote": "PUBLIC and VPC_ENDPOINT endpoint types are not supported.",
      "rationale": "AWS documents Transfer Family endpoint-type limitations and custom-hostname DNS considerations in AWS GovCloud. Because endpoint mode materially affects regulated transfer design while core transfer protocols remain available, the proposed lag is Moderate.",
      "proposedOn": "2026-06-16"
    },
    {
      "capability": "Observability & Monitoring",
      "provider": "aws",
      "field": "parityLag",
      "currentValue": "Unknown",
      "proposedValue": "Minor",
      "sourceUrl": "https://docs.aws.amazon.com/govcloud-us/latest/UserGuide/govcloud-cwl.html",
      "sourceQuote": "The Live Tail feature is not available.",
      "rationale": "AWS documents CloudWatch Logs differences in AWS GovCloud, including HTTPS-only calls, no Live Tail, and no logGroupNamePattern support. The observed feature gap is narrower than the overall monitoring/logging surface, so the proposed lag is Minor.",
      "proposedOn": "2026-06-16"
    },
    {
      "capability": "Event Streaming & Messaging",
      "provider": "aws",
      "field": "govAvailability",
      "currentValue": "Unknown",
